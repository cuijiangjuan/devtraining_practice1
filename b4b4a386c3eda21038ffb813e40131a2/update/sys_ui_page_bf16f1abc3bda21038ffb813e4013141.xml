        }
    </style>
</head>
<body>
    <!-- 页面内容 -->
    <div class="sn-container">
        <h2>功能演示</h2>
        
        <!-- 生成PDF按钮 -->
        <button id="generatePdfButton" class="sn-custom-button sn-generate-pdf">生成PDF</button>
        
        <!-- 状态字段和操作按钮 -->
        <div id="statusField" class="sn-status-field">当前状态: 未更新</div>
        <button id="actionButton" class="sn-custom-button sn-action-button">执行操作</button>
    </div>

    <!-- 对话框 -->
    <div id="dialogOverlay" class="sn-dialog-overlay"></div>
    <div id="dialog" class="sn-dialog-content" style="display: none;">
        <h3>确认操作</h3>
        <p>您确定要执行此操作吗？</p>
        <div class="sn-dialog-buttons">
            <button id="dialogCancel" class="sn-dialog-button cancel">取消</button>
            <button id="dialogOk" class="sn-dialog-button ok">确定</button>
        </div>
    </div>

    <script>
        $(document).ready(function() {
			const { jsPDF } = window.jspdf;
            // 生成PDF按钮点击事件
            $('#generatePdfButton').click(function() {
             //   generatePdf();
				try {
					// 使用jsPDF生成PDF
					var doc = new jsPDF();
					
					// 添加内容到PDF
					doc.text('This is a PDF documentt from ServiceNow', 10, 10);
					doc.text('createDate: ' + new Date().toLocaleString(), 10, 20);
					doc.text('createUser: ' + g_user.getUserName(), 10, 30);
					
					// 保存PDF
					doc.save('servicenow-document-' + new Date().getTime() + '.pdf');
				} catch(e) {
					alert('Error when PDF create: ' + e.message);
					gs.logError('Failure: ' + e, 'UI Page PDF create');
				}
            });

            // 操作按钮点击事件
            $('#actionButton').click(function() {
                $('#dialogOverlay').show();
                $('#dialog').show();
            });

            // 确定按钮点击事件
            $('#dialogOk').click(function() {
                // 关闭对话框
                $('#dialogOverlay').hide();
                $('#dialog').hide();
                
                // 执行GlideAjax更新
                performGlideAjaxUpdate();
            });

            // 取消按钮点击事件
            $('#dialogCancel').click(function() {
                // 关闭对话框
                $('#dialogOverlay').hide();
                $('#dialog').hide();
                console.log("用户取消了操作");
            });

            // 生成PDF函数

            //     ga.getXML(function(response) {
            //         var pdfData = response.responseXML.documentElement.getAttribute("answer");
                    
            //         // 创建下载链接
            //         var blob = new Blob([pdfData], {type: 'application/pdf'});
            //         var url = URL.createObjectURL(blob);
                    
            //         // 创建并触发下载
            //         var a = document.createElement('a');
            //         a.href = url;
            //         a.download = 'record_' + g_form.getUniqueValue() + '.pdf';
            //         document.body.appendChild(a);
            //         a.click();
                    
            //         // 清理
            //         setTimeout(function() {
            //             document.body.removeChild(a);
            //             URL.revokeObjectURL(url);
            //         }, 100);
            //     });
            // }

            // GlideAjax更新函数
            function performGlideAjaxUpdate() {
                // 创建GlideAjax对象
                var ga = new GlideAjax('CustomAjaxProcessor');
                ga.addParam('sysparm_name', 'updateField');
                
                // 添加需要的参数
                ga.addParam('sysparm_record_sys_id', g_user.getUserID());
                ga.addParam('sysparm_new_value', 'new value');
                
                // 处理响应
                ga.getXML(function(response) {
                    var answer = response.responseXML.documentElement.getAttribute("answer");
                    if (answer === 'success') {
                        $('#statusField').text('当前状态: 已更新 - ' + new Date().toLocaleTimeString());
                    } else {
                        $('#statusField').text('当前状态: 更新失败: ' + answer);
                    }
                });
            }
        });
    </script>
</body>
</html>


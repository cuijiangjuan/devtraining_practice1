        <client_script><![CDATA[// 确定按钮点击事件
$('#dialogOk').click(function() {
    performGlideAjaxUpdate();
});

// 取消按钮点击事件
$('#dialogCancel').click(function() {
	top.window.parent.location.reload();
});   
			
function performGlideAjaxUpdate() {
	var sys_id = new URLSearchParams(top.window.location.search).get('sys_id');
	alert('sys_id' + sys_id);
    // 创建GlideAjax对象
    var ga = new GlideAjax('InventoryAssignUpdate');
    ga.addParam('sysparm_name', 'updateAssign');
    // 添加需要的参数
    ga.addParam('sysparm_sys_id', sys_id);
    // 处理响应
    ga.getXMLAnswer(function(response) {
		alert(response);
		if(response) {
			top.window.parent.location.reload();
		}
    });
}]]></client_script>
